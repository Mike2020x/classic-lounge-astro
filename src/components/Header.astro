---
import { business } from '../data/business';
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
      <span class="brand-mark" aria-hidden="true">☕</span>
      <span><strong>Classic</strong><small>LOUNGE</small></span>
    </a>

    <button class="menu-button" type="button" data-menu-button aria-expanded="false" aria-controls="main-menu">
      <span class="sr-only">Abrir menú</span>
      <span aria-hidden="true">☰</span>
    </button>

    <nav id="main-menu" class="main-nav" data-menu aria-label="Navegación principal">
      <a href="#carta">Carta</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#nosotros">Nosotros</a>
      <a href="#ubicacion">Ubicación</a>
      <a class="nav-cta" href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener noreferrer">Reservar / pedir</a>
    </nav>
  </div>
</header>
